# Phase 1+ controlled Minecraft connection settings.
# Secrets/tokens must never be committed.
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=Moxue_Test

# offline: isolated/private test-server identity only.
# microsoft: production online-mode authentication. Tokens are handled by Mineflayer/minecraft-protocol, not stored here.
MC_AUTH=offline

# Leave empty to allow the tested Mineflayer version to negotiate when appropriate.
MC_VERSION=

# error | warn | info | debug
MC_LOG_LEVEL=info

# AI decision provider. Keep `fake` as the safe default until the live provider gate passes.
MC_AI_PROVIDER=fake

# Required only when MC_AI_PROVIDER=gemini. Deliberately no implicit model fallback.
MC_AI_MODEL=

# Required only when MC_AI_PROVIDER=gemini. Never commit a real key.
MC_AI_API_KEY=
