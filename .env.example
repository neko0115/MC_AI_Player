# Phase 1+ controlled Minecraft connection settings.
# Secrets/tokens must never be committed.
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=Moxue_Test

# offline: isolated/private test-server identity only.
# microsoft: production online-mode authentication. Tokens are handled by Mineflayer/minecraft-protocol, not stored here.
MC_AUTH=offline

# Leave empty to allow the tested Mineflayer version to negotiate when appropriate.
MC_VERSION=

# error | warn | info | debug
MC_LOG_LEVEL=info

# AI decision provider. `fake` is the safe default and needs no routing file or Google credential.
MC_AI_PROVIDER=fake

# Gemini multi-model routing config. Required only when MC_AI_PROVIDER=gemini.
# The deployed file lives under data/ and is gitignored; this public value is only the default path.
MC_AI_ROUTING_CONFIG=data/ai-routing.json

# Minecraft chat identity trust anchor. Missing/invalid values fail closed to offline/untrusted.
MC_SERVER_IDENTITY_MODE=offline

# Google Project credentials referenced by apiKeyEnv inside the private routing JSON.
# Never commit real keys.
MC_AI_KEY_PRIMARY=
MC_AI_KEY_BACKUP=

# Explicit opt-in for the real Gemini compatibility validator.
# Leave at 0 for normal runtime and CI. The validator does not execute Minecraft gameplay.
MC_AI_LIVE_VALIDATION=0

# Optional Workspace semantic learning secret.
# When set (at least 32 UTF-8 bytes), previously successful Workspace language
# interpretations are cached locally under data/workspace-semantic-cache.sqlite3.
# The same master secret derives separate HMAC lookup and encrypted-export keys.
# Never commit a real secret.
MC_WORKSPACE_SEMANTIC_MASTER_SECRET=

# Deprecated after multi-model routing migration. Ignored as Gemini routing authority.
MC_AI_MODEL=
MC_AI_API_KEY=

# Local Control API / SSE. Loopback is the safe default.
MC_CONTROL_HOST=127.0.0.1
MC_CONTROL_PORT=8766

# Required whenever MC_CONTROL_HOST is non-loopback (for example 0.0.0.0 or a LAN address).
# Never commit a real bearer token.
MC_CONTROL_TOKEN=

# Maximum accepted JSON request body size in bytes. Valid range: 1..1048576.
MC_CONTROL_MAX_BODY_BYTES=16384

# Optional read-only MoxueBridge capability discovery.
# Leave MC_MOXUEBRIDGE_BASE_URL empty to disable it.
MC_MOXUEBRIDGE_BASE_URL=
MC_MOXUEBRIDGE_TOKEN=
MC_MOXUEBRIDGE_TIMEOUT_MS=800
MC_MOXUEBRIDGE_REFRESH_INTERVAL_MS=30000

# Separate loopback-only AI Admin API. Disabled when MC_ADMIN_TOKEN is empty.
MC_ADMIN_PORT=8767
MC_ADMIN_TOKEN=
